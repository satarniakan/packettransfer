@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using packettransfer.Application.DTOs
@using packettransfer.Application.Services
@using System.Security.Claims
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>پروفایل کاربری</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">پروفایل کاربری</h3>
        <div class="text-body-secondary small">اطلاعات حساب خود را ویرایش کنید.</div>
    </div>
</div>

@if (passwordSuccess)
{
    <div class="alert alert-success">رمز عبور با موفقیت تغییر کرد.</div>
}

@if (profileSuccess)
{
    <div class="alert alert-success">تغییرات ذخیره شد.</div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (profile is null)
{
    <LoadingSkeleton Table="false" Rows="6" />
}
else
{
    <div style="max-width: 560px;">

        @* ===== اطلاعات حساب ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-person"></i>اطلاعات حساب</h6>

            @* نام کاربری فقط نمایشی است و قابل ویرایش نیست *@
            <div class="mb-3">
                <label class="form-label">نام کاربری</label>
                <input type="text" class="form-control" value="@profile.UserName" disabled />
            </div>

            @if (!string.IsNullOrWhiteSpace(profile.PhoneNumber))
            {
                <div class="mb-3">
                    <label class="form-label">شماره موبایل</label>
                    <input type="text" class="form-control" value="@profile.PhoneNumber" disabled />
                </div>
            }

            <div class="mb-3">
                <AppTextField Value="@fullName" ValueChanged="@((string? v) => fullName = v ?? string.Empty)"
                              Label="نام و نام خانوادگی" WrapperClass="" />
            </div>

            <AppTextField Value="@email" ValueChanged="@((string? v) => email = v)"
                          Label="ایمیل" InputType="email" Placeholder="ایمیل خود را وارد کنید"
                          WrapperClass="mb-0" />

            <div class="mt-3">
                <button class="btn btn-primary" disabled="@isSaving" @onclick="HandleSaveProfile">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    ذخیره اطلاعات
                </button>
            </div>
        </div>

        @* ===== تغییر رمز عبور ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-key"></i>تغییر رمز عبور</h6>

            <div class="mb-3">
                <AppTextField Value="@currentPassword" ValueChanged="@((string? v) => currentPassword = v)"
                              Label="رمز فعلی" InputType="password" WrapperClass="" />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <AppTextField Value="@newPassword" ValueChanged="@((string? v) => newPassword = v)"
                                  Label="رمز جدید" InputType="password" Placeholder="حداقل ۶ کاراکتر" WrapperClass="" />
                </div>
                <div class="col-md-6 mb-3">
                    <AppTextField Value="@confirmPassword" ValueChanged="@((string? v) => confirmPassword = v)"
                                  Label="تکرار رمز جدید" InputType="password" WrapperClass="" />
                </div>
            </div>

            <div class="mt-1">
                <button class="btn btn-outline-primary" disabled="@isChangingPassword" @onclick="HandleChangePassword">
                    @if (isChangingPassword)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    تغییر رمز عبور
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "success")]
    private bool profileSuccess { get; set; }

    [SupplyParameterFromQuery(Name = "password")]
    private string? passwordQuery { get; set; }

    private bool passwordSuccess => passwordQuery == "success";

    private UserProfileDto? profile;

    private string fullName = string.Empty;
    private string? email;
    private string? currentPassword;
    private string? newPassword;
    private string? confirmPassword;

    private bool isSaving;
    private bool isChangingPassword;
    private string? errorMessage;

    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (_userId is null) return;

        profile = await AuthService.GetProfileAsync(_userId);
        if (profile is null) return;

        fullName = profile.FullName ?? string.Empty;
        email = profile.Email;
    }

    private async Task HandleSaveProfile()
    {
        if (_userId is null) return;

        isSaving = true;
        errorMessage = null;
        profileSuccess = false;

        try
        {
            var result = await AuthService.UpdateProfileAsync(_userId, fullName, email);

            if (result.Status == ProfileUpdateStatus.Success)
            {
                profileSuccess = true;
                profile = await AuthService.GetProfileAsync(_userId);
            }
            else
            {
                errorMessage = result.Status switch
                {
                    ProfileUpdateStatus.EmailAlreadyExists => "این ایمیل قبلاً توسط کاربر دیگری استفاده شده است.",
                    ProfileUpdateStatus.EmailUpdateFailed => "به‌روزرسانی ایمیل ناموفق بود.",
                    ProfileUpdateStatus.UserNotFound => "کاربر یافت نشد؛ لطفاً دوباره وارد شوید.",
                    ProfileUpdateStatus.FullNameTooLong => "نام کامل نمی‌تواند بیشتر از ۱۰۰ کاراکتر باشد.",
                    _ => "خطای ناشناخته‌ای رخ داد."
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ذخیرهٔ تغییرات: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleChangePassword()
    {
        if (_userId is null) return;

        isChangingPassword = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.ChangePasswordAsync(
                _userId, currentPassword ?? string.Empty, newPassword ?? string.Empty, confirmPassword);

            if (result.Status == ChangePasswordStatus.Success)
            {
                currentPassword = null;
                newPassword = null;
                confirmPassword = null;
                passwordQuery = "success";
            }
            else
            {
                errorMessage = result.Status switch
                {
                    ChangePasswordStatus.WrongCurrentPassword => "رمز فعلی اشتباه است.",
                    ChangePasswordStatus.PasswordMismatch => "رمز جدید و تکرار آن یکسان نیستند.",
                    ChangePasswordStatus.ChangeFailed => "تغییر رمز ناموفق بود (رمز جدید باید حداقل ۶ کاراکتر با عدد و حروف کوچک باشد).",
                    ChangePasswordStatus.ImpersonationBlocked => "در حالت جانشینی امکان تغییر رمز وجود ندارد.",
                    ChangePasswordStatus.UserNotFound => "کاربر یافت نشد؛ لطفاً دوباره وارد شوید.",
                    _ => "خطای ناشناخته‌ای رخ داد."
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در تغییر رمز: {ex.Message}";
        }
        finally
        {
            isChangingPassword = false;
        }
    }
}
